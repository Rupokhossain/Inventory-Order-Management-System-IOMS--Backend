<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Confirmation</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6f8; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="table-layout: fixed;">
    <tr>
      <td align="center" style="padding: 40px 0;">
        <table border="0" cellpadding="0" cellspacing="0" width="600" style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);">
          
          <!-- Header -->
          <tr>
            <td align="center" style="background-color: #e2136e; padding: 30px 20px;">
              <h1 style="color: #ffffff; margin: 0; font-size: 24px; font-weight: 600;">Payment Successful!</h1>
              <p style="color: #ffe6f0; margin: 5px 0 0 0; font-size: 14px;">Your payment for the order has been received.</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 30px;">
              <p style="font-size: 16px; color: #333333; margin-top: 0;">Dear <strong><%= customerName %></strong>,</p>
              <p style="font-size: 14px; color: #555555; line-height: 1.6;">
                Thank you for shopping with us! Your bKash payment for order <strong>#<%= orderId %></strong> has been successfully processed.
              </p>

              <!-- Payment Details Table -->
              <table border="0" cellpadding="12" cellspacing="0" width="100%" style="background-color: #f9fafb; border-radius: 6px; margin: 20px 0; border: 1px solid #e5e7eb;">
                <tr>
                  <td style="font-size: 14px; color: #6b7280; border-bottom: 1px solid #e5e7eb;">Transaction ID:</td>
                  <td style="font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-bottom: 1px solid #e5e7eb;"><%= trxID %></td>
                </tr>
                <tr>
                  <td style="font-size: 14px; color: #6b7280; border-bottom: 1px solid #e5e7eb;">Payment Gateway:</td>
                  <td style="font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-bottom: 1px solid #e5e7eb;">bKash</td>
                </tr>
                <tr>
                  <td style="font-size: 14px; color: #6b7280; border-bottom: 1px solid #e5e7eb;">Order ID:</td>
                  <td style="font-size: 14px; color: #111827; font-weight: 600; text-align: right; border-bottom: 1px solid #e5e7eb;"><%= orderId %></td>
                </tr>
                <tr>
                  <td style="font-size: 15px; color: #111827; font-weight: bold;">Total Amount Paid:</td>
                  <td style="font-size: 18px; color: #e2136e; font-weight: bold; text-align: right;">৳ <%= amount %></td>
                </tr>
              </table>

              <p style="font-size: 14px; color: #555555; line-height: 1.6;">
                We are currently processing your order as quickly as possible. If you have any questions, please feel free to reach out to our support team.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color: #f9fafb; padding: 20px; border-top: 1px solid #e5e7eb; font-size: 12px; color: #9ca3af;">
              <p style="margin: 0;">&copy; <%= new Date().getFullYear() %> Your Company Name. All rights reserved.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>