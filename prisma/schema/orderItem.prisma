model OrderItem {
  id        String     @id @default(ulid())
  orderId   String
  productId String
  quantity  String
  unitPrice Decimal @db.Decimal(10, 2) 

  // Relations
  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId]) 
  @@map("order_items")
}